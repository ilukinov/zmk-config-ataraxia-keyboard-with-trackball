/*
 * Ataraxia v2 (42 keys + PMW3610 trackball)
 *
 * Adapted from the author's Lily58 keymap. The Lily58's bottom three rows map
 * 1:1 onto the Ataraxia's three rows of twelve, so the alphas are untouched.
 * What did not fit -- the number row, the two inner bottom keys and two of the
 * eight thumb keys -- is rehomed on LOWER and RAISE, see the notes below.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * ---------------------------------------------------------------------------
 * LAYER INDICES ARE NOT FREE.
 * ---------------------------------------------------------------------------
 * The PMW3610 driver -- not the input listener -- implements scroll, sniping
 * and ball-as-arrows, and the shield hard-codes which layer index triggers
 * each one. From zmk-keyboards-ataraxia@ataraxia_v2,
 * boards/shields/ataraxia/boards/nice_nano_v2.overlay:
 *
 *     // automouse-layer = <5>;   <- commented out upstream, so unavailable
 *     snipe-layers  = <7>;
 *     scroll-layers = <4 5>;
 *     arrows { layers = <2>; bindings = <&kp RIGHT>, <&kp LEFT>, ... };
 *
 * So SCROLL must be 4 and SNIPE must be 7 to get those behaviours for free.
 * Layer 2 would turn the ball into arrow keys, which is not wanted on a layer
 * held as often as RAISE -- it is left reserved instead. Renumbering these
 * silently changes what the trackball does.
 * ---------------------------------------------------------------------------
 */
#define BASE    0
#define LOWER   1
/*      (2)     reserved -- driver maps ball to arrow keys here */
#define RAISE   3
#define SCROLL  4
/*      (5)     reserved -- driver treats this as a scroll layer too */
#define MOUSE   6
#define SNIPE   7

/* The two hyper keys carried over from the Lily58 layout. */
#define HYP_L   LS(LC(LG(LALT)))
#define HYP_R   RS(RA(RC(RGUI)))


&mt {
    tapping-term-ms = <180>;
};

&lt {
    tapping-term-ms = <180>;
};

/*
 * Moving the ball temporarily activates MOUSE so the right home row becomes
 * mouse buttons. require-prior-idle-ms keeps it from firing mid-word: the ball
 * has to be still for 150ms after the last keystroke before it can take over.
 */
&zip_temp_layer {
    require-prior-idle-ms = <150>;
};

/*
 * The shield declares this listener without a node label, so it can only be
 * reached by path. It sets `input-processors = <&pointer_accel>` -- keep that
 * first so the acceleration curve tuned in the shield still applies.
 */
&{/trackball_listener} {
    input-processors = <&pointer_accel>, <&zip_temp_layer MOUSE 350>;
};


/ {
    combos {
        compatible = "zmk,combos";

        /* Kept from the stock keymap: flash without the reset button. */
        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <2 3 8 9>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ----------------------------------------------------------------
         * 0 BASE -- the Lily58 alpha block, unchanged.
         *
         * Thumbs condense the Lily58's eight into six: the duplicate raise
         * key (&mo 2) is gone, and RET became a layer-tap so LOWER has a
         * home -- on the Lily58 nothing bound &mo 1 and Lower was dead.
         * ---------------------------------------------------------------- */
        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB     &kp Q   &kp W   &kp E   &kp R   &kp T       &kp Y   &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp ESC     &kp A   &kp S   &kp D   &kp F   &kp G       &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C   &kp V   &kp B       &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                    &kp RALT  &kp RCTRL  &mt LGUI BSPC      &lt RAISE SPACE  &lt LOWER RET  &kp RGUI
            >;
        };

        /* ----------------------------------------------------------------
         * 1 LOWER -- the Lily58 Lower layer folded from four rows into three.
         *
         * Rehomed here: both hyper keys on the outer bottom corners, and
         * LC(SPACE) on Lower + the Space thumb.
         * Left thumbs reach the two trackball modes.
         * ---------------------------------------------------------------- */
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp GRAVE   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT       &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp TILDE
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7     &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp HYP_L   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp HYP_R
                          &mo SCROLL    &mo SNIPE     &bt BT_CLR         &kp LC(SPACE)  &trans  &trans
            >;
        };

        /* Reserved: the driver turns the ball into arrow keys on layer 2. */
        reserved_ball_arrows {
            status = "reserved";
        };

        /* ----------------------------------------------------------------
         * 3 RAISE -- the number row back in its original columns, so the
         * digits sit exactly where they did on the Lily58, one thumb hold
         * away. Vim arrows on HJKL.
         * ---------------------------------------------------------------- */
        raise_layer {
            display-name = "Raise";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp N6    &kp N7    &kp N8    &kp N9     &kp N0    &kp EQUAL
&trans      &trans  &trans  &trans  &trans  &trans      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp HOME  &kp END
&trans      &trans  &trans  &trans  &trans  &trans      &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC   &kp BSLH  &kp PSCRN
                            &trans  &trans  &trans              &trans  &trans  &trans
            >;
        };

        /* ----------------------------------------------------------------
         * 4 SCROLL -- index fixed by the shield's scroll-layers = <4 5>.
         * Everything is &trans: the driver does the work, and MOUSE (6)
         * outranks this layer so its clicks stay reachable while scrolling.
         * ---------------------------------------------------------------- */
        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans              &trans  &trans  &trans
            >;
        };

        /* Reserved: scroll-layers = <4 5> makes this a second scroll layer. */
        reserved_scroll_alt {
            status = "reserved";
        };

        /* ----------------------------------------------------------------
         * 6 MOUSE -- activated by moving the ball (zip_temp_layer, above).
         * Right home row becomes the mouse buttons.
         * ---------------------------------------------------------------- */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &trans     &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &mo SNIPE  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mo SCROLL  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &trans     &trans     &trans      &trans
                        &trans  &trans  &trans              &trans  &trans  &trans
            >;
        };

        /* ----------------------------------------------------------------
         * 7 SNIPE -- index fixed by the shield's snipe-layers = <7>.
         * All &trans; the driver slows the ball while this layer is held.
         * ---------------------------------------------------------------- */
        snipe_layer {
            display-name = "Snipe";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans              &trans  &trans  &trans
            >;
        };
    };
};
